+def save_or_skip(save, **settings):
+    """Only an explicit capability error is a skip, never UNKNOWN/500 or a timeout."""
+    try:
+        return save(**settings)
+    except TinkarError as error:
+        if error.code == "failed_precondition" and str(error).startswith(
+            "COORDINATE_REGISTRY_UNAVAILABLE:"
+        ):
+            pytest.skip(str(error))
+        raise
