+package dev.ikm.tinkar.service.service;
+
+import java.util.UUID;
+
+/** Dataset schema is insufficient for saved coordinates; no write was attempted. */
+public class CoordinateCapabilityException extends RuntimeException {
+    public static final String CODE = "COORDINATE_REGISTRY_UNAVAILABLE";
+
+    public CoordinateCapabilityException(String type, UUID registryUuid) {
+        super(CODE + ": dataset does not support saved " + type
+                + " coordinates; requires registry pattern " + registryUuid
+                + " with two string fields (coordinate ID, settings JSON). No write attempted.");
+    }
+}
