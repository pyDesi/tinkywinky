@@ -0,0 +1,51 @@
+package dev.ikm.tinkar.service.service;
+
+import dev.ikm.tinkar.entity.transaction.Transaction;
+import dev.ikm.tinkar.service.controller.knowledgegraph.CoordinateCapabilityAdvice;
+import io.grpc.Status;
+import org.junit.jupiter.api.Test;
+import org.mockito.MockedStatic;
+import org.mockito.Mockito;
+
+import java.util.List;
+import java.util.OptionalLong;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+
+class CoordinateStoreCapabilityTest {
+    @Test
+    void missingRegistriesRefuseEveryOperationBeforeFactoryOrTransaction() {
+        try (MockedStatic<KnownComponents> known = Mockito.mockStatic(KnownComponents.class);
+             MockedStatic<Transaction> transactions = Mockito.mockStatic(Transaction.class);
+             MockedStatic<CoordinateFactory> factory = Mockito.mockStatic(CoordinateFactory.class)) {
+            known.when(() -> KnownComponents.nid(any())).thenReturn(OptionalLong.empty());
+            CoordinateStoreService service = new CoordinateStoreService();
+            List<Runnable> operations = List.of(
+                    () -> service.saveStamp(null), () -> service.saveNavigation(null),
+                    () -> service.saveLanguage(null), () -> service.findAllStamp(),
+                    () -> service.findAllNavigation(), () -> service.findAllLanguage(),
+                    () -> service.findStampById("id"), () -> service.findNavigationById("id"),
+                    () -> service.findLanguageById("id"));
+            for (Runnable operation : operations) {
+                assertThatThrownBy(operation::run)
+                        .isInstanceOf(CoordinateCapabilityException.class)
+                        .hasMessageContaining("COORDINATE_REGISTRY_UNAVAILABLE")
+                        .hasMessageContaining("No write attempted");
+            }
+            transactions.verifyNoInteractions();
+            factory.verifyNoInteractions();
+        }
+    }
+
+    @Test
+    void bothTransportsExplainTheMissingCapability() {
+        var error = new CoordinateCapabilityException("stamp", CoordinateStoreService.STAMP_COORDINATE_REGISTRY_UUID);
+        var advice = new CoordinateCapabilityAdvice();
+        assertThat(CoordinateCapabilityAdvice.rest(error).getStatusCode().value()).isEqualTo(412);
+        assertThat(CoordinateCapabilityAdvice.rest(error).getBody()).containsEntry("code", CoordinateCapabilityException.CODE);
+        assertThat(advice.grpc(error).getCode()).isEqualTo(Status.Code.FAILED_PRECONDITION);
+        assertThat(advice.grpc(error).getDescription()).isEqualTo(error.getMessage());
+    }
+}
