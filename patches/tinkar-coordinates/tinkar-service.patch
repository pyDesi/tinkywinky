+package dev.ikm.tinkar.service.controller.knowledgegraph;
+
+import dev.ikm.tinkar.service.service.CoordinateCapabilityException;
+import io.grpc.Status;
+import net.devh.boot.grpc.server.advice.GrpcAdvice;
+import net.devh.boot.grpc.server.advice.GrpcExceptionHandler;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+import java.util.Map;
+
+/** Keep unsupported dataset errors explicit on both transports. */
+@GrpcAdvice
+public class CoordinateCapabilityAdvice {
+    public static ResponseEntity<Map<String, String>> rest(CoordinateCapabilityException error) {
+        return ResponseEntity.status(HttpStatus.PRECONDITION_FAILED).body(
+                Map.of("code", CoordinateCapabilityException.CODE, "message", error.getMessage()));
+    }
+
+    @GrpcExceptionHandler(CoordinateCapabilityException.class)
+    public Status grpc(CoordinateCapabilityException error) {
+        return Status.FAILED_PRECONDITION.withDescription(error.getMessage());
+    }
+}
