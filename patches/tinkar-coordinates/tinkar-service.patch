+import org.eclipse.collections.api.factory.Lists;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.condition.EnabledIfSystemProperty;
+import org.mockito.MockedStatic;
+import org.mockito.Mockito;
+
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+
+/**
+ * Opt-in only: the caller must extract a NEW public archive and put the ownership
+ * marker beside it. Never point this test at the current store.
+ */
+@EnabledIfSystemProperty(named = "coordinate.disposable.root", matches = ".+")
+class PublicSubsetCoordinateTest {
+    @Test
+    void unsupportedPublicSubsetAllocatesNoEntitiesStampsIdentifiersOrTransactions() throws Exception {
+        Path root = Path.of(System.getProperty("coordinate.disposable.root")).toRealPath();
+        assertThat(root.toString()).contains("/.local/tinkar-verification/run-");
+        assertThat(Files.readString(root.resolve("DISPOSABLE"))).isEqualTo("fresh-public-gudid\n");
+        assertThat(Files.exists(root.resolve("opened"))).isFalse();
+        Files.createFile(root.resolve("opened"));
+        var primitive = new TinkarPrimitiveImpl(root.resolve("data").toString(), "gudidsubset",
+                "Open SpinedArrayStore");
+        try {
+            var store = new CoordinateStoreService();
+            List<UUID> registries = List.of(CoordinateStoreService.STAMP_COORDINATE_REGISTRY_UUID,
+                    CoordinateStoreService.NAVIGATION_COORDINATE_REGISTRY_UUID,
+                    CoordinateStoreService.LANGUAGE_COORDINATE_REGISTRY_UUID);
+            var idsBefore = registries.stream().map(id -> PrimitiveData.get().hasUuid(id)).toList();
+            int entitiesBefore = countEntities();
+            long sequenceBefore = PrimitiveData.get().writeSequence();
+            try (MockedStatic<Transaction> transactions = Mockito.mockStatic(Transaction.class)) {
+                for (Runnable operation : List.<Runnable>of(
+                        () -> store.saveStamp(null), () -> store.saveNavigation(null),
+                        () -> store.saveLanguage(null), () -> store.findAllStamp(),
+                        () -> store.findAllNavigation(), () -> store.findAllLanguage(),
+                        () -> store.findStampById("id"), () -> store.findNavigationById("id"),
+                        () -> store.findLanguageById("id"))) {
+                    assertThatThrownBy(operation::run).isInstanceOf(CoordinateCapabilityException.class);
+                }
+                transactions.verifyNoInteractions();
+            }
+            assertThat(PrimitiveData.get().writeSequence()).isEqualTo(sequenceBefore);
+            assertThat(countEntities()).isEqualTo(entitiesBefore);
+            assertThat(registries.stream().map(id -> PrimitiveData.get().hasUuid(id)).toList())
+                    .isEqualTo(idsBefore);
+            System.out.println("PUBLIC SUBSET: 9 capability refusals; no transactions, entities, stamps or registry ID allocations");
+            // Test-only provisioning, NOT a service migration: the shipped subset above
+            // remains unsupported. Exercise supported behavior on this disposable copy.
+            for (UUID registry : registries) {
+                installTestRegistry(registry);
+            }
+            verifySupportedSaveListAndIdempotency(store);
+            verifyFailureAfterStampAllocation(store);
+        } finally {
+            primitive.close();
+        }
+    }
+
+    private int countEntities() {
+        var count = new AtomicInteger();
+        EntityService.get().forEachEntity(entity -> count.incrementAndGet());
+        return count.get();
+    }
+
+    private void installTestRegistry(UUID id) {
+        Transaction tx = Transaction.make("TEST ONLY: coordinate registry");
+        try {
+            var stamp = tx.getStamp(State.ACTIVE, System.currentTimeMillis(), KernelConcept.USER.nid(),
+                    KernelConcept.SOLOR_OVERLAY_MODULE.nid(), KernelConcept.DEVELOPMENT_PATH.nid());
+            RecordListBuilder<PatternVersionRecord> versions = RecordListBuilder.make();
+            PatternRecord pattern = PatternRecord.makeNew(PublicIds.of(id), versions);
+            long meaning = KernelConcept.STRING.nid();
+            versions.add(new PatternVersionRecord(pattern, stamp.nid(), meaning, meaning,
+                    Lists.immutable.of(
+                            new FieldDefinitionRecord(meaning, meaning, meaning, stamp.nid(), pattern.nid(), 0),
+                            new FieldDefinitionRecord(meaning, meaning, meaning, stamp.nid(), pattern.nid(), 1))));
+            EntityService.get().putEntity(pattern);
+            tx.addComponent(pattern);
+            tx.commit();
+        } catch (RuntimeException error) {
+            tx.cancel();
+            throw error;
+        }
+    }
+
+    private void verifySupportedSaveListAndIdempotency(CoordinateStoreService store) {
+        var stamp = store.saveStamp(null);
+        var navigation = store.saveNavigation(null);
+        var language = store.saveLanguage(null);
+        long sequence = PrimitiveData.get().writeSequence();
+        assertThat(store.saveStamp(null)).isEqualTo(stamp);
+        assertThat(store.saveNavigation(null)).isEqualTo(navigation);
+        assertThat(store.saveLanguage(null)).isEqualTo(language);
